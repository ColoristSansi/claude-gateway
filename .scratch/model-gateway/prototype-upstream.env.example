# 原型上游凭据：复制成 prototype-upstream.env 并填值
# 不要把这个文件的真实版本提交到任何版本库，也不要把值贴进对话。
# 两个上游都接（用户已确认：opencode 与 commandcode 两家都接）。

OPENCODE_BASE_URL=
OPENCODE_API_KEY=
# 备注：opencode Go 计划需要自定义 UA 与 x-opencode-session 头，网关侧自动处理，这里不用填。
# 已知：路径带协议族前缀（/openai、/anthropic），每个模型只属一个 family。

COMMANDCODE_BASE_URL=
COMMANDCODE_API_KEY=
# 备注：commandcode 的 Claude 模型只能走 /provider/v1/messages；Go 计划可能无 API 权限（403）。

# 可选：网关自身监听端口，默认 8787
GATEWAY_PORT=8787
