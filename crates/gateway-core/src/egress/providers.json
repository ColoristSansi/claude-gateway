[
  {
    "id": "commandcode",
    "name": "commandcode",
    "baseUrl": "https://api.commandcode.ai/provider/v1",
    "wire": "openai-chat",
    "paths": {
      "anthropic": "/messages",
      "openai-chat": "/chat/completions",
      "openai-responses": "/responses"
    },
    "auth": { "default": "bearer" },
    "quirks": [],
    "note": "baseUrl 自带 /v1，不要再追加。Claude 系模型只在这个上游的 /messages 上可用，走 chat / responses 会 400；Go 计划在该上游无 API 权限（403）。",
    "docUrl": "https://commandcode.ai/docs/provider"
  },
  {
    "id": "opencode",
    "name": "opencode（Console inference）",
    "baseUrl": "https://opencode.ai/inference",
    "wire": "openai-chat",
    "paths": {
      "anthropic": "/anthropic/v1/messages",
      "openai-chat": "/openai/v1/chat/completions",
      "openai-responses": "/openai/v1/responses"
    },
    "auth": { "default": "bearer" },
    "quirks": [
      ["ClientUserAgent", "claude-gateway/0.1"],
      ["ModelsListNeedsCredential", ""]
    ],
    "note": "一个模型只属于一个 API family，发错端点直接报错；模型清单只认带凭据那份（未授权的全量列表勾了会 403）。",
    "docUrl": "https://opencode.ai/v2/docs/console/api/inference/"
  },
  {
    "id": "opencode-go",
    "name": "opencode（Go 订阅）",
    "baseUrl": "https://opencode.ai/inference/go",
    "wire": "openai-chat",
    "paths": {
      "anthropic": "/v1/messages",
      "openai-chat": "/v1/chat/completions",
      "openai-responses": "/v1/responses"
    },
    "auth": { "default": "bearer" },
    "quirks": [
      ["ClientUserAgent", "claude-gateway/0.1"],
      ["SessionIdHeader", "x-opencode-session"]
    ],
    "note": "Go 面要求专属 UA 与会话头；/models 在 <base>/v1/models。",
    "docUrl": "https://opencode.ai/v2/docs/console/go/"
  },
  {
    "id": "qwen-anthropic",
    "name": "千问 Qwen（Anthropic 兼容面）",
    "baseUrl": "https://maas.qianwenaiapi.com/apps/anthropic",
    "wire": "anthropic",
    "paths": {
      "anthropic": "/v1/messages"
    },
    "auth": { "default": "x-api-key" },
    "quirks": [["NoModelsEndpoint", ""]],
    "note": "Anthropic 兼容端点只有 /v1/messages，没有 /v1/models（模型发现必然 404，手填模型 ID）。baseUrl 不要带 /v1。Token Plan 用 token-plan. 前缀的域名与 sk-sp- key。",
    "docUrl": "https://platform.qianwenai.com/docs/api-reference/chat/anthropic"
  },
  {
    "id": "qwen-openai",
    "name": "千问 Qwen（OpenAI 兼容面）",
    "baseUrl": "https://maas.qianwenaiapi.com/compatible-mode/v1",
    "wire": "openai-chat",
    "paths": {
      "openai-chat": "/chat/completions",
      "openai-responses": "/responses"
    },
    "auth": { "default": "bearer" },
    "quirks": [],
    "note": "OpenAI 兼容面 baseUrl 自带 /compatible-mode/v1；旧路径 /api/v2/apps/protocols/... 已停止维护。",
    "docUrl": "https://platform.qianwenai.com/docs/api-reference/chat/openai-chat"
  },
  {
    "id": "deepseek",
    "name": "DeepSeek（OpenAI 兼容面）",
    "baseUrl": "https://api.deepseek.com",
    "wire": "openai-chat",
    "paths": {
      "openai-chat": "/v1/chat/completions",
      "openai-responses": "/v1/responses"
    },
    "auth": { "default": "bearer" },
    "quirks": [],
    "note": "官方文档的 base_url 不带 /v1（SDK 自己加）；该主机在鉴权前统一返回 401，探测路径存在性没有意义。",
    "docUrl": "https://api-docs.deepseek.com/zh-cn/"
  },
  {
    "id": "deepseek-anthropic",
    "name": "DeepSeek（Anthropic 兼容面）",
    "baseUrl": "https://api.deepseek.com/anthropic",
    "wire": "anthropic",
    "paths": {
      "anthropic": "/v1/messages"
    },
    "auth": { "default": "x-api-key" },
    "quirks": [],
    "note": "Anthropic 面在另一个路径上：<base>/v1/messages；anthropic-version 会被忽略。",
    "docUrl": "https://api-docs.deepseek.com/zh-cn/"
  }
]
